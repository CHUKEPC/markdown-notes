# Django Settings
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Either provide full DATABASE_URL or individual DB_* variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/markdown_notes_db
DB_NAME=markdown_notes_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
